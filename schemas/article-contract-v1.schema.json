{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "TchpArticleContractV1",
  "description": "Строгий контракт данных для технических статей портала «Точка Плавления» (Версия 1.0)",
  "type": "object",
  "required": [
    "content_id",
    "schema_version",
    "title",
    "slug",
    "excerpt",
    "category_slug",
    "tags",
    "reading_time",
    "difficulty",
    "solder_alloy",
    "temp_data",
    "tools",
    "content_html"
  ],
  "properties": {
    "content_id": {
      "type": "string",
      "pattern": "^tchp-[a-z0-9-]+$",
      "description": "Постоянный уникальный идентификатор материала (генерируется системой)"
    },
    "content_hash": {
      "type": "string",
      "description": "Хэш содержимого для контроля версий и детекции изменений"
    },
    "schema_version": {
      "type": "string",
      "enum": ["1.0"]
    },
    "title": {
      "type": "string",
      "minLength": 10,
      "maxLength": 200,
      "description": "Точный технический заголовок статьи"
    },
    "slug": {
      "type": "string",
      "pattern": "^[a-z0-9-]+$",
      "description": "URL slug статьи латиницей"
    },
    "excerpt": {
      "type": "string",
      "minLength": 30,
      "maxLength": 400,
      "description": "Краткое инженерное резюме (лид)"
    },
    "category_slug": {
      "type": "string",
      "enum": ["start", "materialy", "praktika", "oshibki"],
      "description": "Утвержденный системный слаг рубрики"
    },
    "tags": {
      "type": "array",
      "items": { "type": "string", "minLength": 2 },
      "minItems": 1,
      "uniqueItems": true
    },
    "reading_time": {
      "type": "integer",
      "minimum": 1,
      "maximum": 60
    },
    "difficulty": {
      "type": "string",
      "enum": ["Базовый", "Инженер", "Эксперт"]
    },
    "solder_alloy": {
      "type": "string",
      "enum": [
        "pos61",
        "sn63pb37",
        "pos40",
        "sac305",
        "sac405",
        "sn42bi58",
        "snbiago",
        "roze",
        "vuda",
        "universal"
      ],
      "description": "Канонический идентификатор сплава из реестра материалов ТЧП"
    },
    "temp_data": {
      "type": "object",
      "required": ["kind", "range"],
      "properties": {
        "kind": {
          "type": "string",
          "enum": ["station_setpoint", "joint_temperature", "reflow_profile"],
          "description": "Тип температурного параметра"
        },
        "range": {
          "type": "string",
          "minLength": 3,
          "description": "Рабочий диапазон, напр. '217 – 235 °C'"
        },
        "peak": {
          "type": "string",
          "description": "Пиковая допустимая температура, напр. '245 °C'"
        }
      },
      "additionalProperties": false
    },
    "standard_data": {
      "type": "object",
      "properties": {
        "standard": {
          "type": "string",
          "minLength": 2,
          "description": "Обозначение стандарта (ГОСТ 21931, IPC-A-610G, J-STD-004)"
        },
        "class": {
          "type": "string",
          "description": "Класс или категория (КЛАСС 1, КЛАСС 2, КЛАСС 3)"
        },
        "description": {
          "type": "string",
          "description": "Краткое описание применимости стандарта"
        }
      },
      "additionalProperties": false
    },
    "tools": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["name"],
        "properties": {
          "name": { "type": "string", "minLength": 2 },
          "model": { "type": "string" },
          "purpose": { "type": "string" }
        },
        "additionalProperties": false
      }
    },
    "content_html": {
      "type": "string",
      "minLength": 100,
      "description": "Основное тело статьи в HTML формате с разметкой ТЧП"
    },
    "faq": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["q", "a"],
        "properties": {
          "q": { "type": "string", "minLength": 5 },
          "a": { "type": "string", "minLength": 10 }
        },
        "additionalProperties": false
      }
    },
    "sources": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["title"],
        "properties": {
          "title": { "type": "string", "minLength": 5 },
          "standard": { "type": "string" },
          "url": { "type": "string" }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
